{
  "color": {
    "void": "#0b0c0c",
    "void-2": "#141616",
    "bone": "#edeae3",
    "bone-2": "#dcd6cb",
    "ink": "#0b0c0c",
    "on-dark": "#edeae3",
    "on-dark-soft": "#b8b6ad",
    "ash": "#8b8e88",
    "on-bone-soft": "#4b4d49",
    "accent": "#8fd6cd",
    "line": "rgba(237,234,227,0.16)",
    "line-strong": "rgba(237,234,227,0.34)",
    "line-dark": "rgba(11,12,12,0.16)"
  },
  "font": {
    "display": ["Oswald", "Arial Narrow", "Helvetica Neue", "sans-serif"],
    "text": ["Jost", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"]
  },
  "size": {
    "xs": "0.8125rem",
    "s": "0.9375rem",
    "body": "clamp(1rem, 0.96rem + 0.2vw, 1.125rem)",
    "lead": "clamp(1.1875rem, 1rem + 0.75vw, 1.625rem)",
    "h3": "clamp(1.375rem, 1.15rem + 1.1vw, 2rem)",
    "h2": "clamp(2.125rem, 1.3rem + 3.4vw, 4.25rem)",
    "h1": "clamp(2.75rem, 1.2rem + 7vw, 7rem)",
    "mega": "clamp(3rem, 14vw, 11rem)"
  },
  "space": {
    "pad": "clamp(1.25rem, 5vw, 5rem)",
    "gap": "clamp(3.5rem, 8vw, 7.5rem)",
    "bar": "64px"
  },
  "radius": "0",
  "shadow": "none",
  "breakpoints": {
    "tablet": "960px",
    "phone": "820px"
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "reveal": "600ms",
    "hover": "200ms"
  }
}
